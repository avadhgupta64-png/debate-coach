# Debate Coach Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Server
PORT=5000

# Frontend URL for CORS (adjust for production)
FRONTEND_URL=http://localhost:5173

# AI Provider - OpenAI-compatible interface
# Leave blank to run in DEMO MODE (no real AI calls, realistic mock responses)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Examples for other providers:
# OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1
# Groq:        AI_BASE_URL=https://api.groq.com/openai/v1
# Ollama:      AI_BASE_URL=http://localhost:11434/v1
